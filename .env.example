# ---------------------------------------------------------------------------
# KSITM Super App — environment configuration
# Copy to `.env` (or set these in your host/container environment).
# Nothing here is required to boot in development; production requirements are
# marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Sessions / security ---------------------------------------------------
# REQUIRED in production. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the server refuses to start in production.
SESSION_SECRET=

# Session lifetime in days (default 7). Sessions slide on activity.
SESSION_TTL_DAYS=7

# Set true when the app is served over HTTPS (default: true in production).
COOKIE_SECURE=
# Only needed if the app must share its cookie across sub-domains.
COOKIE_DOMAIN=

# First administrator account, created on boot if it does not exist.
# REQUIRED in production (the dev fallback is a well-known password).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Institutional e-mail domains allowed to register (comma separated).
ALLOWED_EMAIL_DOMAINS=ksitm.edu.ng

# Extra browser origins allowed to make writes when the frontend is hosted on a
# different origin than the API (comma separated). Not needed when one Node
# process serves both, which is the default deployment.
ALLOWED_ORIGINS=

# --- Database --------------------------------------------------------------
# Option A (recommended for real deployments): a managed PostgreSQL 12+.
# DATABASE_URL=postgres://user:password@host:5432/ksitm
DATABASE_URL=

# Option B (zero-setup): embedded PostgreSQL (PGlite) writes its data here.
# Defaults to server/.pgdata
PGDATA_DIR=

# --- Uploads / limits ------------------------------------------------------
# Maximum upload size in bytes (default 8 MB). Files are stored in the database.
MAX_UPLOAD_BYTES=8388608

# --- AI tutor --------------------------------------------------------------
# Google Gemini API key. Without it the AI tutor reports "not configured" and
# every other feature still works. The key is used server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Override only for proxies/tests.
GEMINI_BASE_URL=

# --- Presentation ----------------------------------------------------------
# Current academic session label shown on results and the student dashboard.
SESSION_LABEL=2025/2026
# Absolute URL of the deployed app (used in notification/e-mail links).
CLIENT_URL=
# Where the built frontend lives (default: web/dist next to the server package).
PUBLIC_DIR=

# --- Development only ------------------------------------------------------
# Target the Vite dev server proxies /api to (default http://127.0.0.1:4000).
API_PROXY_TARGET=
