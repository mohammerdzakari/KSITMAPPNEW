    "db:seed:demo": "tsx src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2"
  }
}
